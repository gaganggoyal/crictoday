# Public site origin, no trailing slash. Example: https://cricketmatch.today
NEXT_PUBLIC_SITE_URL=

# Supabase. Publishable key is the current name for the old anon key.
# Secret key is the current name for the old service_role key. Server only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Resend. Leave blank to log email on the server.
RESEND_API_KEY=
EMAIL_FROM=

# Fixture and ticket providers. Adapters stay idle when these are empty.
SPORTMONKS_API_TOKEN=
TICKETMASTER_API_KEY=

# Protects /api/cron/sync. Required before the route will run.
CRON_SECRET=

# 32+ random characters. Required in production for email encryption and session cookies.
ENCRYPTION_KEY=

# Optional. Analytics and error reporting stay off when empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# Set to true only when you intentionally want labelled DEMO fixtures outside local development.
ALLOW_DEMO_DATA=
