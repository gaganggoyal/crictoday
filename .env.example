# Public site origin, no trailing slash. Read at build time. Example: https://cricketmatch.today
NEXT_PUBLIC_SITE_URL=

# MySQL 8. When this is a mysql:// URL the app reads and writes this database, and the
# Supabase settings below are ignored. Example: mysql://cricketmatch:password@127.0.0.1:3306/cricketmatch
DATABASE_URL=

# Supabase. Publishable key is the current name for the old anon key.
# Secret key is the current name for the old service_role key. Server only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Outbound email. EMAIL_FROM example: cricketmatch.today <hello@cricketmatch.today>
# SMTP is used when SMTP_HOST is set (port 465 is TLS from the start, 587 is STARTTLS),
# then Resend when RESEND_API_KEY is set. With neither, mail is written to the server log.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Fixture and ticket providers. Adapters stay idle when these are empty.
SPORTMONKS_API_TOKEN=
TICKETMASTER_API_KEY=

# Protects /api/cron/sync. Required before the route will run.
CRON_SECRET=

# 32+ random characters. Required in production for email encryption and session cookies.
ENCRYPTION_KEY=

# Where profile logos and photos are written. Keep it outside the checkout so deploys keep them.
# Empty means .data/uploads in the project. Production: /var/lib/cricketmatch/uploads
UPLOAD_DIR=

# Optional. Analytics and error reporting stay off when empty. The privacy policy says the site
# uses no analytics, so update it before setting these.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# Optional. The token from Google Search Console's "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=

# Demo store only: set to true to show the labelled DEMO catalogue outside local development.
# With MySQL, load it with `pnpm db seed-demo` instead.
ALLOW_DEMO_DATA=
